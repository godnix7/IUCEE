# UrbanSense Environment Configuration
# Copy this file to .env and fill in the required values.
#   copy .env.example .env

# =============================================================================
# ENVIRONMENT — 'development' or 'production'
# Controls: seed user creation, secret validation, SQLite fallback
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# SECURITY — REQUIRED in production (startup will fail without these)
# =============================================================================
SECRET_KEY=your-secure-random-secret-key-here

# =============================================================================
# DATABASE — PostgreSQL/PostGIS for production, SQLite for development
# =============================================================================
# DATABASE_URL=postgresql://urbansense:your_password@localhost:5432/urbansense_gis

# =============================================================================
# DEVELOPMENT SEED USERS — Only used when ENVIRONMENT=development
# These credentials are NEVER hardcoded in source code.
# =============================================================================
SEED_ADMIN_EMAIL=admin@urbansense.ai
SEED_ADMIN_PASSWORD=changeme_admin

SEED_PLANNER_EMAIL=planner@urbansense.ai
SEED_PLANNER_PASSWORD=changeme_planner

SEED_VIEWER_EMAIL=viewer@urbansense.ai
SEED_VIEWER_PASSWORD=changeme_viewer

# =============================================================================
# AI MODEL — Pretrained aerial segmentation checkpoint
# =============================================================================
PRETRAINED_SEGFORMER_MODEL=wu-pr-gw/segformer-b2-finetuned-with-LoveDA

# =============================================================================
# STORAGE & UPLOAD
# =============================================================================
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=500

# =============================================================================
# JWT TOKEN LIFETIMES
# =============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OSM OVERPASS API
# =============================================================================
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# =============================================================================
# DOCKER COMPOSE — Used by docker-compose.yml
# =============================================================================
# POSTGRES_USER=urbansense
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=urbansense_gis
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=your_secure_minio_password
